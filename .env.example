# Public URL and TLS domain
DOMAIN=clipforge.nayankunwar.com
CLIPFORGE_APP_ENV=production
CLIPFORGE_PUBLIC_BASE_URL=https://clipforge.nayankunwar.com
CLIPFORGE_SESSION_COOKIE_SECURE=true

# Generate these with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CLIPFORGE_SECRET_KEY=change-me
CLIPFORGE_TOKEN_ENCRYPTION_KEY=change-me

# Runtime data (inside the container)
CLIPFORGE_DATA_DIR=/data

# Bootstrap admin (created only when the database has no users)
CLIPFORGE_ADMIN_EMAIL=you@example.com
CLIPFORGE_ADMIN_INITIAL_PASSWORD=change-me-after-first-login

# Limits (defaults mirror the plan)
CLIPFORGE_MAX_UPLOAD_BYTES=4294967296
CLIPFORGE_MAX_SOURCE_SECONDS=7200
CLIPFORGE_USER_STORAGE_BYTES=16106127360
CLIPFORGE_MAX_INVITED_USERS=5
CLIPFORGE_UPLOAD_DAILY_GLOBAL=5
CLIPFORGE_UPLOAD_DAILY_PER_USER=2
CLIPFORGE_DEFAULT_SKIP_TRANSCRIPT=true
CLIPFORGE_DEFAULT_FFMPEG_PRESET=veryfast

# Brevo transactional email
CLIPFORGE_BREVO_API_KEY=
CLIPFORGE_BREVO_SENDER_EMAIL=no-reply@nayankunwar.com
CLIPFORGE_BREVO_SENDER_NAME=ClipForge

# Google OAuth (Web application)
CLIPFORGE_GOOGLE_CLIENT_ID=
CLIPFORGE_GOOGLE_CLIENT_SECRET=
CLIPFORGE_GOOGLE_REDIRECT_URI=https://clipforge.nayankunwar.com/api/v1/oauth/google/callback

# Set to the public hostname(s) in production.
CLIPFORGE_ALLOWED_HOSTS=clipforge.nayankunwar.com
